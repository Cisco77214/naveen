        preserve_color = cmds.checkBox(self.cb_preserve_color, q=True, value=True)
        delete_existing = cmds.checkBox(self.cb_delete_existing, q=True, value=True)
        create_missing = cmds.checkBox(self.cb_create_missing, q=True, value=True)

        left_tok = cmds.textField(self.tf_left_token, q=True, text=True).strip()
        right_tok = cmds.textField(self.tf_right_token, q=True, text=True).strip()
        left_tokens, right_tokens = build_token_lists(left_tok, right_tok)

        src_field = cmds.textField(self.tf_source, q=True, text=True).strip()
        tgt_field = cmds.textField(self.tf_target, q=True, text=True).strip()

        pairs = []

        if src_field and tgt_field:
            pairs = [(src_field, tgt_field)]
        else:
            sel = cmds.ls(selection=True, long=True) or []
            if not sel:
                cmds.warning("No controls selected.")
                self.set_status("No controls selected.")
                return

            if method == "name":
                for node in sel:
                    short_name = node.split("|")[-1]
                    opposite = get_opposite_control(short_name, direction, left_tokens, right_tokens)
                    if not opposite:
                        pairs.append((node, None))
                        continue
                    if cmds.objExists(opposite):
                        pairs.append((node, opposite))
                    else:
                        pairs.append((node, None))
            else:
                if len(sel) == 2:
                    pairs = [(sel[0], sel[1])]
                elif len(sel) > 2:
                    sel_by_short = {}
                    for s in sel:
                        sel_by_short[s.split("|")[-1]] = s
                    used = set()
                    for node in sel:
                        short_name = node.split("|")[-1]
                        if short_name in used:
                            continue
                        opposite_short = get_opposite_control(short_name, direction, left_tokens, right_tokens)
                        if opposite_short and opposite_short in sel_by_short:
                            pairs.append((node, sel_by_short[opposite_short]))
                            used.add(short_name)
                            used.add(opposite_short)
                else:
                    cmds.warning("Select both a source and a target control.")
                    self.set_status("Select both a source and a target control.")
                    return

        if not pairs:
            self.set_status("No valid control pairs found. Check your naming tokens or selection.")
            return

        if delete_existing:
            targets_with_shapes = [t for _, t in pairs if t and cmds.objExists(t) and get_curve_shapes(t)]
            if targets_with_shapes:
                confirm = cmds.confirmDialog(
                    title="Confirm Mirror",
                    message=("This will delete and replace the existing curve shapes on "
                              "{0} target control(s). Continue?").format(len(targets_with_shapes)),
                    button=["Continue", "Cancel"], defaultButton="Continue", cancelButton="Cancel",
                    dismissString="Cancel")
                if confirm != "Continue":
                    self.set_status("Mirror cancelled by user.")
                    return

        summary, results = mirror_control_shape(
            pairs, axis=axis, pivot=pivot, space=space,
            preserve_color=preserve_color, delete_existing=delete_existing,
            create_missing=create_missing)

        self.report(summary, results)

    def report(self, summary, results):
        lines = []
        for status, source, target, message in results:
            if status == "OK":
                lines.append("OK: {0} -> {1}".format(source, target))
            elif status == "MISSING":
                lines.append("Target not found: {0} -> {1}".format(source, target if target else "?"))
            else:
                lines.append("FAILED: {0} -> {1} ({2})".format(source, target, message))

        lines.append("")
        lines.append("Mirror completed.")
        lines.append("Processed: {0}".format(summary["processed"]))
        lines.append("Successful: {0}".format(summary["successful"]))
        lines.append("Missing targets: {0}".format(summary["missing"]))
        lines.append("Failed: {0}".format(summary["failed"]))

        self.set_status("\n".join(lines))

        if summary["successful"] and not summary["failed"]:
            cmds.inViewMessage(amg="Mirror completed successfully.", pos="midCenter", fade=True)
        elif summary["failed"]:
            cmds.warning("Mirror completed with {0} failure(s). See the tool status log.".format(summary["failed"]))


